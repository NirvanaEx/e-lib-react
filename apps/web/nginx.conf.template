# Снаружи TLS терминирует отдельный nginx и проксирует сюда обычным http,
# поэтому $scheme здесь всегда "http". Если исходный протокол уже пришёл в
# заголовке — передаём его дальше, иначе API считает https-запросы http-овыми
# (это видно в аудите и ломает любую логику, завязанную на протокол).
map $http_x_forwarded_proto $forwarded_proto {
  default $scheme;
  ~. $http_x_forwarded_proto;
}

server {
  listen 80;
  server_name _;

  # Держим чуть выше MAX_UPLOAD_SIZE_MB (200): запас на multipart-обвязку,
  # чтобы отказ по размеру приходил от API внятным JSON, а не сырой
  # HTML-страницей 413 от nginx, которую фронтенд разобрать не может.
  client_max_body_size 210m;

  root /usr/share/nginx/html;
  index index.html;

  # Порт API берётся из APP_PORT — того же, на котором его поднимает compose.
  # Раньше здесь было зашито 3001, а API слушал 3006, и проксирование молча
  # отдавало 502. Никто этого не замечал, потому что фронт собирался с
  # абсолютным адресом и ходил в API мимо nginx, наружу.
  location /api/ {
    proxy_pass http://api:${APP_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    # Заливка сотен мегабайт по медленному каналу дольше стандартных 60с:
    # без этого соединение рвётся на середине большого файла.
    client_body_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
