server {
  listen 80;
  server_name _;

  # API upload handlers allow images up to 10 MiB. Leave room for multipart
  # headers so Nginx does not reject a valid upload before it reaches the API.
  client_max_body_size 12m;

  root /usr/share/nginx/html;
  index index.html;

  # Порт API берётся из APP_PORT — того же, на котором его поднимает compose.
  # Раньше здесь было зашито 3001, а API слушал 3006, и проксирование молча
  # отдавало 502. Никто этого не замечал, потому что фронт собирался с
  # абсолютным адресом и ходил в API мимо nginx, наружу.
  location /api/ {
    proxy_pass http://api:${APP_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
