# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=elib
DB_PASSWORD=elib
DB_NAME=elib

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=30d
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
# Cookie lifetime in seconds; keep in sync with JWT_EXPIRES_IN. Empty/0 = session cookie (dropped on browser close). 2592000 = 30 days.
AUTH_COOKIE_MAX_AGE=2592000
# Brute-force lockout: after LOGIN_MAX_ATTEMPTS failed logins for the same
# account within LOGIN_LOCKOUT_MINUTES, further attempts return 429. The same
# window applies per source IP with a 6x budget (offices share one NAT address).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# App
APP_PORT=3003
APP_HOST=0.0.0.0
DEFAULT_DATA_LANG=ru
TRASH_TTL_DAYS=30
UPLOAD_DIR=../uploads
ALLOWED_EXTENSIONS=pdf,txt,docx
ALLOWED_MIME_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document
MAX_UPLOAD_SIZE_MB=10
MAX_TREE_DEPTH=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SWAGGER_ENABLED=true
# Set only when a reverse proxy terminates connections in front of the API.
# "false" (default) = use the socket address; "true"/number = trust that many
# hops; or an express expression like "loopback, 10.0.0.0/8". Leaving this on
# without a proxy lets clients spoof their IP via X-Forwarded-For.
TRUST_PROXY=false
# Optional storage quota (GB) for the dashboard storage widget. Empty = the
# widget falls back to real free space on the uploads volume.
STORAGE_QUOTA_GB=

# Frontend
WEB_PORT=3000
VITE_API_URL=http://localhost:3003/api
